# Copie para .env (que fica fora do git) e ajuste os valores.
SERVICE_NAME=execution-service

# Mesmo segredo da Lambda autogiro-auth e do Kong; no mínimo 32 caracteres.
JWT_SECRET=troque-por-um-segredo-com-32-caracteres-ou-mais

LOG_LEVEL=INFO
CORS_ORIGINS=*

# Conexões com o banco e a mensageria.
MONGODB_URL=mongodb://mongo:27017/?replicaSet=rs0
MONGODB_DATABASE=autogiro_execution
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
# Capacidade da fila de execução (EnfileiramentoRecusado acima disso).
EXECUTION_QUEUE_CAPACITY=20
